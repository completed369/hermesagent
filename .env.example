# =============================================================================
# VentureOS - Environment Configuration Template
# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env file. NEVER put production secrets here.
# =============================================================================

# --- General ---
NODE_ENV=development
APP_NAME=VentureOS
APP_BASE_CURRENCY=EUR
APP_DEFAULT_LOCALE=en
LOG_LEVEL=info

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=VentureOS

# --- API (apps/api) ---
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
# Secure default: ignore X-Forwarded-For. Set only to the exact trusted reverse-proxy hop count.
API_TRUST_PROXY_HOPS=0
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# --- Database (PostgreSQL via Docker Compose) ---
POSTGRES_USER=ventureos
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=ventureos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ventureos:change-me-dev-only@localhost:5432/ventureos?schema=public

# --- Auth ---
# Generate locally with: openssl rand -base64 32
AUTH_SECRET=replace-with-generated-32-byte-secret
# Use a distinct generated secret. Rotation intentionally resets pseudonymous abuse buckets.
AUTH_ABUSE_DIGEST_SECRET=replace-with-distinct-generated-32-byte-secret
AUTH_REGISTRATION_MIN_RESPONSE_MS=300
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_COOKIE_NAME=ventureos_session
DEV_LOGIN_ENABLED=true
DEV_FOUNDER_EMAIL=founder@ventureos.local
DEV_FOUNDER_PASSWORD=change-me-dev-only

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ventureos-main
TEMPORAL_UI_PORT=8088

# --- MinIO / Object Storage ---
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=ventureos
MINIO_ROOT_PASSWORD=change-me-dev-only
MINIO_BUCKET=ventureos-dev
MINIO_USE_SSL=false
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_FILE_SIZE_MB=25

# --- AI Provider (mock by default; no paid credentials required) ---
AI_PROVIDER=mock
AI_MODEL_ALLOWLIST=mock-board-agent-v1
AI_PER_AGENT_TOKEN_LIMIT=8000
AI_PER_AGENT_COST_LIMIT_EUR=0.50
AI_PER_WORKFLOW_COST_LIMIT_EUR=3.00
AI_PER_DAY_COST_LIMIT_EUR=10.00
AI_PER_WORKSPACE_MONTHLY_LIMIT_EUR=100.00
# ANTHROPIC_API_KEY=          # leave unset in development; mock provider is used

# --- Marketplace adapters (mock/draft-only by default) ---
MARKETPLACE_ETSY_MODE=mock
MARKETPLACE_ETSY_API_KEY=
MARKETPLACE_ETSY_API_SECRET=

# --- Feature flags / governance defaults ---
FEATURE_LIVE_PUBLISHING_ENABLED=false
FEATURE_ADVERTISING_ENABLED=false
FEATURE_PAID_INTEGRATIONS_ENABLED=false
GOVERNANCE_BOARD_APPROVAL_THRESHOLD=75
GOVERNANCE_EVIDENCE_QUALITY_MINIMUM=70

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
