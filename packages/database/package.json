{
  "name": "@ventureos/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "reset-founder-password": "dotenv -e ../../.env -- tsx src/reset-founder-password.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@ventureos/auth": "workspace:*",
    "@ventureos/scoring-engine": "workspace:*",
    "@ventureos/security": "workspace:*",
    "@ventureos/policy-engine": "workspace:*",
    "@ventureos/contracts": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^3.2.6",
    "dotenv-cli": "^7.4.2",
    "@types/node": "^22.7.5"
  }
}
