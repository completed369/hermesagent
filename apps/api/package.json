{
  "name": "@ventureos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch --webpack",
    "build": "nest build && node ../../scripts/assert-api-entrypoint.mjs",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --dir src",
    "test:integration": "dotenv -e ../../.env -- vitest run --dir test",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "@ventureos/config": "workspace:*",
    "@ventureos/contracts": "workspace:*",
    "@ventureos/database": "workspace:*",
    "@ventureos/auth": "workspace:*",
    "@ventureos/observability": "workspace:*",
    "@ventureos/security": "workspace:*",
    "@ventureos/integrations": "workspace:*",
    "@ventureos/workflows": "workspace:*",
    "@ventureos/agent-runtime": "workspace:*",
    "@ventureos/policy-engine": "workspace:*",
    "@ventureos/product-studio": "workspace:*",
    "@ventureos/research-connectors": "workspace:*",
    "@ventureos/marketplace-connectors": "workspace:*",
    "@ventureos/finance-engine": "workspace:*",
    "@ventureos/billing": "workspace:*",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "supertest": "^7.0.0",
    "@types/node": "^22.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.2",
    "rimraf": "^6.0.1",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "tsx": "^4.19.1",
    "ts-loader": "^9.5.1",
    "webpack": "^5.95.0",
