{
  "name": "@ventureos/worker",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@temporalio/client": "^1.11.3",
    "@temporalio/worker": "^1.11.3",
    "@temporalio/workflow": "^1.11.3",
    "@temporalio/activity": "^1.11.3",
    "@ventureos/config": "workspace:*",
    "@ventureos/observability": "workspace:*",
    "@ventureos/workflows": "workspace:*",
    "@ventureos/agent-runtime": "workspace:*",
    "@ventureos/product-studio": "workspace:*",
    "@ventureos/marketplace-connectors": "workspace:*",
    "@ventureos/integrations": "workspace:*",
    "@ventureos/database": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^3.2.6",
    "@types/node": "^22.7.5",
    "dotenv-cli": "^7.4.2",
    "rimraf": "^6.0.1"
  }
}
