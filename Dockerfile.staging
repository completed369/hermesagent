# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS builder
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV COREPACK_HOME=/corepack
WORKDIR /workspace

RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*
RUN mkdir -p "$COREPACK_HOME" \
 && chmod 0755 "$COREPACK_HOME" \
 && corepack enable \
 && corepack prepare pnpm@9.12.0 --activate \
 && chmod -R a+rX "$COREPACK_HOME"
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts/assert-api-entrypoint.mjs scripts/assert-worker-entrypoint.mjs ./scripts/
RUN pnpm install --frozen-lockfile
RUN DATABASE_URL='postgresql://ventureos:build-only-password@localhost:5432/ventureos?schema=public' pnpm db:generate

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV VENTUREOS_STANDALONE_BUILD=true
RUN pnpm build

FROM builder AS test-tools
ENV NODE_ENV=test
USER node

FROM builder AS deployer
RUN set -eu; \
    pnpm --filter @ventureos/api deploy --prod /runtime/api; \
    pnpm --filter @ventureos/worker deploy --prod /runtime/worker; \
    pnpm --filter @ventureos/database deploy --prod /runtime/tools; \
    cp -R /workspace/apps/web/.next/standalone /runtime/web; \
    prune_runtime_package() { \
      runtime=$1; \
      virtual_store_pattern=$2; \
      package_path=$3; \
      set -- "$runtime/node_modules/.pnpm"/$virtual_store_pattern; \
      test -e "$1"; \
      find "$runtime/node_modules" -type l -path "*/node_modules/$package_path" -delete; \
      for package_store in "$@"; do \
        test -e "$package_store"; \
        rm -rf "$package_store"; \
      done; \
      test -z "$(find "$runtime/node_modules" -path "*/node_modules/$package_path" -print -quit)"; \
    }; \
    prune_optional_runtime_package() { \
      runtime=$1; \
      virtual_store_pattern=$2; \
      package_path=$3; \
      find "$runtime/node_modules" -type l -path "*/node_modules/$package_path" -delete; \
      for package_store in "$runtime/node_modules/.pnpm"/$virtual_store_pattern; do \
        test ! -e "$package_store" || rm -rf "$package_store"; \
      done; \
      test -z "$(find "$runtime/node_modules" -path "*/node_modules/$package_path" -print -quit)"; \
    }; \
    prune_scarf_compile_cache() { \
      runtime=$1; \
      set -- "$runtime/node_modules/.pnpm"/@scarf+scarf@*/node_modules/@scarf/scarf; \
      test -d "$1"; \
      for scarf_store in "$@"; do \
        test -d "$scarf_store"; \
        rm -rf "$scarf_store/node-compile-cache"; \
      done; \
      test -z "$(find "$runtime/node_modules/.pnpm" -path '*/@scarf/scarf/node-compile-cache' -print -quit)"; \
    }; \
    prune_dotenv_docs() { \
      runtime=$1; \
      set -- "$runtime/node_modules/.pnpm"/dotenv@*/node_modules/dotenv; \
      test -d "$1"; \
      for dotenv_store in "$@"; do \
        test -d "$dotenv_store"; \
        find "$dotenv_store" -maxdepth 1 -type f -iname 'README*' -delete; \
      done; \
      test -z "$(find "$runtime/node_modules/.pnpm" -path '*/node_modules/dotenv/README*' -print -quit)"; \
    }; \
    prune_runtime_package /runtime/api '@types+node@*' '@types/node'; \
    prune_optional_runtime_package /runtime/api 'typescript@*' 'typescript'; \
    prune_runtime_package /runtime/worker '@types+node@*' '@types/node'; \
    prune_runtime_package /runtime/worker '@types+estree@*' '@types/estree'; \
    prune_runtime_package /runtime/worker '@types+json-schema@*' '@types/json-schema'; \
    prune_optional_runtime_package /runtime/worker 'typescript@*' 'typescript'; \
    prune_optional_runtime_package /runtime/tools 'typescript@*' 'typescript'; \
    prune_optional_runtime_package /runtime/web 'typescript@*' 'typescript'; \
    prune_scarf_compile_cache /runtime/api; \
    prune_dotenv_docs /runtime/api; \
    prune_dotenv_docs /runtime/worker; \
    prune_dotenv_docs /runtime/tools; \
    core_bridge="$(echo /runtime/worker/node_modules/.pnpm/@temporalio+core-bridge@*/node_modules/@temporalio/core-bridge)"; \
    test -f "$core_bridge/Cargo.lock"; \
    rm -rf "$core_bridge/sdk-core" "$core_bridge/bridge-macros" \
      "$core_bridge/Cargo.lock" "$core_bridge/Cargo.toml"; \
    generated_client="$(echo /workspace/node_modules/.pnpm/@prisma+client@*/node_modules/.prisma)"; \
    for runtime in /runtime/api /runtime/worker /runtime/tools; do \
      client_parent="$(echo "$runtime"/node_modules/.pnpm/@prisma+client@*/node_modules)"; \
      mkdir -p "$client_parent/.prisma"; \
      cp -R "$generated_client/." "$client_parent/.prisma/"; \
    done

FROM node:22-trixie-slim@sha256:db8a96a63e5264607ada2d206758876ebbed6a12be2ada7517793cbfb0c2a29c AS runtime-node

FROM gcr.io/distroless/cc-debian13@sha256:053b9adbc028d9c3ad170973748a22bb23863c828d21029369c8ff641a5c5f42 AS runtime-libgcc

FROM node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS runtime-tools-node

FROM gcr.io/distroless/cc-debian12@sha256:adcd20c7b4c988b73cbfbddb26d2eee574571e6d7c9ffea29b3821e0690efb77 AS tools-runtime
COPY --from=runtime-tools-node /usr/local/bin/node /nodejs/bin/node
ENTRYPOINT ["/nodejs/bin/node"]

FROM gcr.io/distroless/base-nossl-debian13@sha256:caa5ae9098199275fb38b6bd62aa1c3ec240119907df634a55cc6f1d52668dab AS runtime
COPY --from=runtime-node /usr/local/bin/node /nodejs/bin/node
COPY --from=runtime-libgcc /usr/lib/x86_64-linux-gnu/libgcc_s.so.1 /usr/lib/x86_64-linux-gnu/libgcc_s.so.1
COPY --from=runtime-libgcc /usr/lib/x86_64-linux-gnu/libstdc++.so.6* /usr/lib/x86_64-linux-gnu/
COPY --from=runtime-libgcc /var/lib/dpkg/status.d/libgcc-s1 /var/lib/dpkg/status.d/libgcc-s1
COPY --from=runtime-libgcc /var/lib/dpkg/status.d/libstdc++6 /var/lib/dpkg/status.d/libstdc++6
ENTRYPOINT ["/nodejs/bin/node"]

FROM tools-runtime AS tools
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deployer --chown=65532:65532 /runtime/tools/ ./
COPY --chown=65532:65532 scripts/runtime-secret-entrypoint.mjs /usr/local/bin/runtime-secret-entrypoint.mjs
USER 65532:65532
ENTRYPOINT ["/nodejs/bin/node", "/usr/local/bin/runtime-secret-entrypoint.mjs", "--"]
CMD ["/nodejs/bin/node", "node_modules/prisma/build/index.js", "migrate", "deploy", "--schema", "prisma/schema.prisma"]

FROM runtime AS api
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deployer --chown=65532:65532 /runtime/api/ ./
COPY --chown=65532:65532 scripts/runtime-secret-entrypoint.mjs /usr/local/bin/runtime-secret-entrypoint.mjs
USER 65532:65532
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=3s --retries=12 CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:3001/api/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
ENTRYPOINT ["/nodejs/bin/node", "/usr/local/bin/runtime-secret-entrypoint.mjs", "--"]
CMD ["/nodejs/bin/node", "dist/main.js"]

FROM runtime AS worker
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deployer --chown=65532:65532 /runtime/worker/ ./
COPY --chown=65532:65532 scripts/runtime-secret-entrypoint.mjs /usr/local/bin/runtime-secret-entrypoint.mjs
USER 65532:65532
EXPOSE 3002
HEALTHCHECK --interval=10s --timeout=3s --retries=12 CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:3002/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
ENTRYPOINT ["/nodejs/bin/node", "/usr/local/bin/runtime-secret-entrypoint.mjs", "--"]
CMD ["/nodejs/bin/node", "dist/index.js"]

FROM runtime AS web
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
COPY --from=deployer --chown=65532:65532 /runtime/web/ ./
COPY --from=builder --chown=65532:65532 /workspace/apps/web/.next/static/ ./apps/web/.next/static/
USER 65532:65532
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --retries=12 CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:3000/login').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["apps/web/server.js"]

FROM runtime AS ingress
ENV NODE_ENV=production
WORKDIR /app
COPY --chown=65532:65532 scripts/staging-ingress-proxy.mjs ./
USER 65532:65532
CMD ["staging-ingress-proxy.mjs"]
