# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS builder
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV COREPACK_HOME=/corepack
WORKDIR /workspace

RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*
RUN mkdir -p "$COREPACK_HOME" \
 && chmod 0755 "$COREPACK_HOME" \
 && corepack enable \
 && corepack prepare pnpm@9.12.0 --activate \
 && chmod -R a+rX "$COREPACK_HOME"
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts/assert-api-entrypoint.mjs scripts/assert-worker-entrypoint.mjs ./scripts/
RUN pnpm install --frozen-lockfile
RUN pnpm db:generate

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV VENTUREOS_STANDALONE_BUILD=true
RUN pnpm build

FROM builder AS tools
ENV NODE_ENV=production
USER node
CMD ["pnpm", "db:migrate"]

FROM builder AS deployer
RUN pnpm --filter @ventureos/api deploy --prod /runtime/api \
 && pnpm --filter @ventureos/worker deploy --prod /runtime/worker \
 && generated_client="$(echo /workspace/node_modules/.pnpm/@prisma+client@*/node_modules/.prisma)" \
 && for runtime in /runtime/api /runtime/worker; do \
      client_parent="$(echo "$runtime"/node_modules/.pnpm/@prisma+client@*/node_modules)"; \
      mkdir -p "$client_parent/.prisma"; \
      cp -R "$generated_client/." "$client_parent/.prisma/"; \
    done

FROM node:22-bookworm-slim AS api
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=deployer --chown=node:node /runtime/api/ ./
USER node
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=3s --retries=12 CMD ["node", "-e", "fetch('http://127.0.0.1:3001/api/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "dist/main.js"]

FROM node:22-bookworm-slim AS worker
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=deployer --chown=node:node /runtime/worker/ ./
USER node
EXPOSE 3002
HEALTHCHECK --interval=10s --timeout=3s --retries=12 CMD ["node", "-e", "fetch('http://127.0.0.1:3002/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "dist/index.js"]

FROM node:22-bookworm-slim AS web
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
COPY --from=builder --chown=node:node /workspace/apps/web/.next/standalone/ ./
COPY --from=builder --chown=node:node /workspace/apps/web/.next/static/ ./apps/web/.next/static/
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --retries=12 CMD ["node", "-e", "fetch('http://127.0.0.1:3000/login').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "apps/web/server.js"]

FROM node:22-bookworm-slim AS ingress
ENV NODE_ENV=production
WORKDIR /app
COPY --chown=node:node scripts/staging-ingress-proxy.mjs ./
USER node
CMD ["node", "staging-ingress-proxy.mjs"]
