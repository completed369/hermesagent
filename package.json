{
  "name": "ventureos",
  "version": "0.1.0",
  "private": true,
  "description": "VentureOS - Human-Controlled AI Business Operating System",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "js-yaml": "5.2.2",
      "@prisma/config@6.19.3>deepmerge-ts": "8.0.1",
      "postcss": "8.5.26",
      "sharp": "0.35.0",
      "vite": "6.4.3",
      "nanoid": "3.3.18",
      "browserslist": "4.28.7",
      "decode-uri-component": "0.5.0",
      "fast-uri": "3.1.6"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "node --test scripts/*.test.mjs && turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm run build && pnpm --filter @ventureos/web run test:e2e",
    "test:build-orchestration": "node scripts/verify-api-build.mjs",
    "repository:artifact-hygiene": "node scripts/repository-artifact-hygiene.mjs --check",
    "docs:api:check": "node scripts/generate-api-inventory.mjs --check",
    "docs:api:update": "node scripts/generate-api-inventory.mjs --write",
    "db:generate": "pnpm --filter @ventureos/database run generate",
    "db:migrate": "pnpm --filter @ventureos/database run migrate",
    "db:migrate:dev": "pnpm --filter @ventureos/database run migrate:dev",
    "db:seed": "pnpm --filter @ventureos/database run seed",
    "db:reset-founder-password": "pnpm --filter @ventureos/database run reset-founder-password",
    "db:studio": "pnpm --filter @ventureos/database run studio",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "ajv": "8.20.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "js-yaml": "5.2.2",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
