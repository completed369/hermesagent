{
  "name": "ventureos",
  "version": "0.1.0",
  "private": true,
  "description": "VentureOS - Human-Controlled AI Business Operating System",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "node --test scripts/api-build-contract.test.mjs && turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm run build && pnpm --filter @ventureos/web run test:e2e",
    "test:build-orchestration": "node scripts/verify-api-build.mjs",
    "db:generate": "pnpm --filter @ventureos/database run generate",
    "db:migrate": "pnpm --filter @ventureos/database run migrate",
    "db:migrate:dev": "pnpm --filter @ventureos/database run migrate:dev",
    "db:seed": "pnpm --filter @ventureos/database run seed",
    "db:reset-founder-password": "pnpm --filter @ventureos/database run reset-founder-password",
    "db:studio": "pnpm --filter @ventureos/database run studio",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint-config-prettier": "^9.1.0",
    "rimraf": "^6.0.1"
  }
}
